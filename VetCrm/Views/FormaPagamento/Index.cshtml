@model List<VetCrm.ViewModels.FormaPagamentoViewModel>

@{
    ViewData["Title"] = "Formas de Pagamento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Formas de Pagamento</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nova Forma de Pagamento</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar">✏️</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">🗑️</a>
                </td>
            </tr>
        }
    </tbody>
</table>

