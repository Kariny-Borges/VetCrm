@model IEnumerable<VetCrm.ViewModels.InternacaoViewModel>

@{
    ViewData["Title"] = "Internações";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🏥 Internações</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nova Internação</a>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Paciente</th>
            <th>Motivo</th>
            <th>Data Entrada</th>
            <th>Data Saída</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Paciente?.Nome</td>
                <td>@item.Motivo</td>
                <td>@item.DataEntrada.ToString("dd/MM/yyyy")</td>
                <td>@(item.DataSaida?.ToString("dd/MM/yyyy") ?? "-")</td>
                <td>
                    @if (item.DataSaida == null)
                    {
                        <span class="badge text-bg-warning">Internado</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">Alta</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Editar">✏️</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes">👁️</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">🗑️</a>
                </td>
            </tr>
        }
    </tbody>
</table>