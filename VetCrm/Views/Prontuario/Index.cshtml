@model IEnumerable<VetCrm.ViewModels.ProntuarioViewModel>

@{
    ViewData["Title"] = "Prontuários";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📄 Prontuários</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Prontuário</a>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Data Registro</th>
            <th>Diagnóstico</th>
            <th>Tratamento</th>
            <th>Paciente</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DataRegistro.ToString("dd/MM/yyyy")</td>
                <td>@item.Diagnostico</td>
                <td>@item.Tratamento</td>
                <td>@item.Paciente?.Nome</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Editar">✏️</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes">👁️</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">🗑️</a>
                </td>
            </tr>
        }
    </tbody>
</table>
