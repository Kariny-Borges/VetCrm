@using VetCrm.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetCrm</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VetCrm.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">VetCrm</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            @if (User.Pode(Permissoes.AgendaVer))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agenda" asp-action="Index">📅 Agenda</a>
                                </li>
                            }
                            @if (User.PodeAlgum(Permissoes.ProprietarioVer, Permissoes.PacienteVer, Permissoes.EspecieVer,
                                                Permissoes.RacaVer, Permissoes.UsuarioVer, Permissoes.EstabelecimentoVer))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Cadastros
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (User.Pode(Permissoes.ProprietarioVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Proprietario" asp-action="Index">Proprietários</a></li>
                                        }
                                        @if (User.Pode(Permissoes.PacienteVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Paciente" asp-action="Index">Pacientes</a></li>
                                        }
                                        @if (User.Pode(Permissoes.EspecieVer) || User.Pode(Permissoes.RacaVer))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        @if (User.Pode(Permissoes.EspecieVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Especies" asp-action="Index">Espécies</a></li>
                                        }
                                        @if (User.Pode(Permissoes.RacaVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Raca" asp-action="Index">Raças</a></li>
                                        }
                                        @if (User.Pode(Permissoes.UsuarioVer) || User.Pode(Permissoes.EstabelecimentoVer))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        @if (User.Pode(Permissoes.UsuarioVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Usuários</a></li>
                                        }
                                        @if (User.Pode(Permissoes.EstabelecimentoVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Estabelecimento" asp-action="Index">Estabelecimentos</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (User.PodeAlgum(Permissoes.VeterinarioVer, Permissoes.EspecialidadeVer, Permissoes.ConsultaVer,
                                                Permissoes.InternacaoVer, Permissoes.ExameVer, Permissoes.VacinaVer))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Clínica
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (User.Pode(Permissoes.VeterinarioVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Veterinario" asp-action="Index">Veterinários</a></li>
                                        }
                                        @if (User.Pode(Permissoes.EspecialidadeVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Especialidades" asp-action="Index">Especialidades</a></li>
                                        }
                                        @if (User.Pode(Permissoes.ConsultaVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Consulta" asp-action="Index">Consultas</a></li>
                                        }
                                        @if (User.Pode(Permissoes.InternacaoVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Internacao" asp-action="Index">Internação</a></li>
                                        }
                                        @if (User.Pode(Permissoes.ExameVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Exames" asp-action="Index">Exames</a></li>
                                        }
                                        @if (User.Pode(Permissoes.VacinaVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Vacina" asp-action="Index">Vacinas</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (User.Pode(Permissoes.ProdutoVer) || User.Pode(Permissoes.CategoriaVer))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Estoque
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (User.Pode(Permissoes.ProdutoVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Produto" asp-action="Index">Produtos</a></li>
                                        }
                                        @if (User.Pode(Permissoes.CategoriaVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Categoria" asp-action="Index">Categorias</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (User.Pode(Permissoes.ServicoVer) || User.Pode(Permissoes.FormaPagamentoVer))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Financeiro
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (User.Pode(Permissoes.ServicoVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Servico" asp-action="Index">Serviços</a></li>
                                        }
                                        @if (User.Pode(Permissoes.FormaPagamentoVer))
                                        {
                                            <li><a class="dropdown-item" asp-controller="FormaPagamento" asp-action="Index">Formas de Pagamento</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @* pega a primeira letra do nome pra mostrar no avatar *@
                            var nomeUsuario = User.Identity.Name ?? "";
                            var inicial = nomeUsuario.Length > 0 ? nomeUsuario.Substring(0, 1).ToUpper() : "?";

                            <li class="nav-item d-flex align-items-center">
                                <span class="navbar-text nav-greeting me-3">Olá, <strong>@nomeUsuario</strong></span>
                            </li>

                            <li class="nav-item dropdown">
                                <!-- o avatar é o botão que abre o menu -->
                                <a class="nav-link p-0" href="#" role="button" data-bs-toggle="dropdown">
                                    <div class="avatar-usuario rounded-circle d-flex align-items-center justify-content-center">
                                        @inicial
                                    </div>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Perfil" asp-action="Index">
                                            <strong>@nomeUsuario</strong>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Perfil" asp-action="AlterarSenha">
                                            <span class="item-icone">🔒</span> Alterar Senha
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item disabled" href="#">
                                            <span class="item-icone">🖼️</span> Alterar Foto
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item item-sair">
                                                <span class="item-icone">🚪</span> Sair
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>