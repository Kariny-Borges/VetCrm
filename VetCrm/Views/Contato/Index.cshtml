@model VetCrm.ViewModels.ListaPaginadaViewModel<VetCrm.ViewModels.ContatoViewModel>

@{
    ViewData["Title"] = "Contatos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📞 Contatos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Contato</a>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Valor</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Itens)
        {
            <tr>
                <td>@item.Tipo</td>
                <td>@item.Valor</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Editar">✏️</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes">👁️</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">🗑️</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Paginacao" model="Model" />
